{
  "name": "csp-coverage",
  "displayName": "CSP Coverage",
  "description": "Live test-coverage gutters, stale markers, and quality diagnostics from any Coverage Server Protocol (CSP) server — Rust, Go, TypeScript, and more.",
  "version": "0.1.0",
  "publisher": "csp",
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0d1117",
    "theme": "dark"
  },
  "homepage": "https://github.com/decentparadox/csp",
  "bugs": {
    "url": "https://github.com/decentparadox/csp/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/decentparadox/csp.git",
    "directory": "clients/vs-extension"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Testing",
    "Visualization"
  ],
  "keywords": [
    "coverage",
    "test coverage",
    "code coverage",
    "gutter",
    "csp",
    "rust",
    "go",
    "typescript",
    "lcov"
  ],
  "pricing": "Free",
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "csp.refresh",
        "title": "Refresh Coverage",
        "category": "CSP",
        "icon": "$(refresh)"
      },
      {
        "command": "csp.restart",
        "title": "Restart Coverage Server",
        "category": "CSP",
        "icon": "$(debug-restart)"
      },
      {
        "command": "csp.toggleGutters",
        "title": "Toggle Coverage Gutters",
        "category": "CSP",
        "icon": "$(eye)"
      },
      {
        "command": "csp.showLog",
        "title": "Show Server Log",
        "category": "CSP",
        "icon": "$(output)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "csp.refresh",
          "group": "navigation",
          "when": "csp.active"
        }
      ]
    },
    "configuration": {
      "title": "CSP Coverage",
      "properties": {
        "csp.serverPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to the `csp-server` binary. If empty, the extension looks for a built binary under the workspace's `target/{release,debug}` and the CSP repo, then falls back to `csp-server` on `PATH`."
        },
        "csp.framework": {
          "type": "string",
          "enum": [
            "auto",
            "cargo-llvm-cov",
            "go",
            "istanbul",
            "lcov"
          ],
          "enumDescriptions": [
            "Let the server detect the coverage tool from the project.",
            "Rust — cargo-llvm-cov.",
            "Go — go test -coverprofile.",
            "JavaScript/TypeScript — Istanbul / nyc / vitest.",
            "Any tool that emits an lcov.info report."
          ],
          "default": "auto",
          "description": "Force a coverage adapter. 'auto' lets the server detect it from the project."
        },
        "csp.enableGutters": {
          "type": "boolean",
          "default": true,
          "description": "Render covered/uncovered lines as colored bars in the editor gutter."
        },
        "csp.noAutorun": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Set `CSP_NO_AUTORUN` so the server only reports an existing coverage artifact instead of running the project's coverage tool itself."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "typecheck": "tsc --noEmit",
    "package": "vsce package"
  },
  "dependencies": {
    "vscode-jsonrpc": "^8.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.24.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.3.0"
  }
}
