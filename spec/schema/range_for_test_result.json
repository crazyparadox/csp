{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RangeForTestResult",
  "description": "Result of `csp/rangeForTest` — the source locations a test covers.",
  "type": "object",
  "required": [
    "locations"
  ],
  "properties": {
    "locations": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Location"
      }
    }
  },
  "definitions": {
    "Location": {
      "description": "A location inside a document — a URI plus a range. Mirrors LSP `Location`.",
      "type": "object",
      "required": [
        "range",
        "uri"
      ],
      "properties": {
        "range": {
          "$ref": "#/definitions/Range"
        },
        "uri": {
          "type": "string"
        }
      }
    },
    "Position": {
      "description": "Zero-based line/character position, identical in shape to LSP `Position`.",
      "type": "object",
      "required": [
        "character",
        "line"
      ],
      "properties": {
        "character": {
          "description": "Zero-based character offset within the line (UTF-16 code units, as in LSP).",
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "line": {
          "description": "Zero-based line number.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        }
      }
    },
    "Range": {
      "description": "A range between two positions, end-exclusive — identical to LSP `Range`.",
      "type": "object",
      "required": [
        "end",
        "start"
      ],
      "properties": {
        "end": {
          "$ref": "#/definitions/Position"
        },
        "start": {
          "$ref": "#/definitions/Position"
        }
      }
    }
  }
}
