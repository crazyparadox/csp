{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TestsForRangeResult",
  "description": "Result of `csp/testsForRange` — the tests that exercise the given range.",
  "type": "object",
  "required": [
    "tests"
  ],
  "properties": {
    "tests": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/TestItem"
      }
    }
  },
  "definitions": {
    "Location": {
      "description": "A location inside a document — a URI plus a range. Mirrors LSP `Location`.",
      "type": "object",
      "required": [
        "range",
        "uri"
      ],
      "properties": {
        "range": {
          "$ref": "#/definitions/Range"
        },
        "uri": {
          "type": "string"
        }
      }
    },
    "Position": {
      "description": "Zero-based line/character position, identical in shape to LSP `Position`.",
      "type": "object",
      "required": [
        "character",
        "line"
      ],
      "properties": {
        "character": {
          "description": "Zero-based character offset within the line (UTF-16 code units, as in LSP).",
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "line": {
          "description": "Zero-based line number.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        }
      }
    },
    "Range": {
      "description": "A range between two positions, end-exclusive — identical to LSP `Range`.",
      "type": "object",
      "required": [
        "end",
        "start"
      ],
      "properties": {
        "end": {
          "$ref": "#/definitions/Position"
        },
        "start": {
          "$ref": "#/definitions/Position"
        }
      }
    },
    "TestItem": {
      "description": "A test known to the server (a single test case, not a file). `id` is opaque and server-assigned; the client uses it for `csp/rangeForTest` lookups.",
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "location": {
          "description": "Where the test is defined, if the adapter can locate it.",
          "anyOf": [
            {
              "$ref": "#/definitions/Location"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "description": "Human-readable name, e.g. `tests::math::adds_two_numbers`.",
          "type": "string"
        }
      }
    }
  }
}
